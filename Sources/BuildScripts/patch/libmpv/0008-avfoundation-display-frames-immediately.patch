+// Hand a finished frame to the display layer for immediate display.
+//
+// mpv decides when a frame is due, so the layer must not schedule it as well.
+// The control timebase belongs to the host (it drives the PiP progress UI and is
+// only re-synced on large drifts), so it can run ahead of the content and later
+// jump back. A frame stamped ahead of a timebase that jumps back stays queued
+// and is shown again when the timebase reaches its timestamp: a stale frame,
+// with its burned-in subtitles, flashing a moment after a seek or a stall.
+static bool enqueue_pixel_buffer(struct vo *vo, CVPixelBufferRef pixbuf)
+{
+    struct priv *p = vo->priv;
+
+    CMTimebaseRef timebase = [p->displayLayer controlTimebase];
+    CMSampleTimingInfo info = {
+        .presentationTimeStamp = timebase ? CMTimebaseGetTime(timebase) : kCMTimeInvalid,
+        .duration = kCMTimeInvalid,
+        .decodeTimeStamp = kCMTimeInvalid
+    };
+
+    CMFormatDescriptionRef format = NULL;
+    OSStatus err = CMVideoFormatDescriptionCreateForImageBuffer(NULL, pixbuf, &format);
+    if (err != noErr || !format) {
+        MP_ERR(vo, "Failed to create format description: %d\n", (int)err);
+        return false;
+    }
+
+    CMSampleBufferRef buf = NULL;
+    err = CMSampleBufferCreateReadyWithImageBuffer(NULL, pixbuf, format, &info, &buf);
+    CFRelease(format);
+    if (err != noErr || !buf) {
+        MP_ERR(vo, "Failed to create sample buffer: %d\n", (int)err);
+        return false;
+    }
+
+    CFArrayRef attachments = CMSampleBufferGetSampleAttachmentsArray(buf, YES);
+    CFDictionarySetValue(
+        (CFMutableDictionaryRef)CFArrayGetValueAtIndex(attachments, 0),
+        kCMSampleAttachmentKey_DisplayImmediately,
+        kCFBooleanTrue
+    );
+
+    [p->displayLayer enqueueSampleBuffer:buf];
+    CFRelease(buf);
+    return true;
+}
+
